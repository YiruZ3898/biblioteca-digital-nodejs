<section class="error-page text-center py-5">
    <p class="error-code mb-2"><%= statusCode %></p>
    <h1 class="mb-3">Algo no salió como esperábamos</h1>
    <p class="lead text-muted mb-4"><%= message %></p>

    <% if (details) { %>
        <details class="error-details text-start mx-auto mb-4">
            <summary>Detalles técnicos</summary>
            <pre class="mt-3 mb-0"><%= details %></pre>
        </details>
    <% } %>

    <a class="btn btn-primary" href="/">Volver al inicio</a>
</section>
