<h1>Catálogo de Libros</h1>

<hr>

<% books.forEach((book, index) => { %>

   <div class="book-card">

    <div class="book-card">

        <h3 class="book-card">
            <%= book.title %>
        </h3>

        <p>
            Autor:
            <%= book.author %>
        </p>

        <p>
            Categoría:
            <%= book.category %>
        </p>

        <a
        class="btn btn-primary"
        href="/books/<%= book.id %>">

            Ver Detalle

        </a>

        <% if (user && user.role === 'admin') { %>

            <a
            class="btn btn-warning"
            href="/books/<%= book.id %>/edit">

                Editar

            </a>

            <a
            class="btn btn-danger"
            href="/books/<%= book.id %>/delete">

                Eliminar

            </a>

        <% } %>

    </div>

</div>
<% }) %>

