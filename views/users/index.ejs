<section class="users-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted small fw-bold mb-1">Administración</p>
            <h1 class="mb-0">Gestión de usuarios</h1>
        </div>
        <span class="badge text-bg-light border px-3 py-2">
            <%= users.length %> usuario<%= users.length === 1 ? "" : "s" %>
        </span>
    </div>

    <% if (message) { %>
        <div class="alert alert-warning" role="alert">
            <%= message %>
        </div>
    <% } %>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Usuario</th>
                    <th scope="col">Correo electrónico</th>
                    <th scope="col">Rol</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach((registeredUser) => { %>
                    <tr>
                        <td><%= registeredUser.id %></td>
                        <td class="fw-semibold"><%= registeredUser.username %></td>
                        <td><%= registeredUser.email %></td>
                        <td>
                            <% if (registeredUser.role === "admin") { %>
                                <span class="badge text-bg-primary">Administrador</span>
                            <% } else { %>
                                <span class="badge text-bg-secondary">Usuario</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <% if (registeredUser.role === "user") { %>
                                <form action="/users/role/<%= registeredUser.id %>" method="POST" class="d-inline">
                                    <input type="hidden" name="role" value="admin">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        Convertir en Administrador
                                    </button>
                                </form>
                            <% } else { %>
                                <form action="/users/role/<%= registeredUser.id %>" method="POST" class="d-inline">
                                    <input type="hidden" name="role" value="user">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        Convertir en Usuario
                                    </button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>
